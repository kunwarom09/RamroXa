# ==============================================================================
# RAMROXA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `server/.env` (NEVER commit `server/.env` to Git!)
# 2. Configure the variables below according to your environment.
# 3. Test your email setup anytime with: `npm run email:test`
# ==============================================================================

# --- Environment & Port ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local persistent MongoDB instance (zero-config, auto-seeded on first run)
MONGODB_URI=mongodb://localhost:27017/zylo_ecommerce

# --- Security & JWT Authentication ---
# Minimum 16 characters each. Use strong, random keys in production.
JWT_ACCESS_SECRET=zylo_super_secret_jwt_access_key_development_2026
JWT_REFRESH_SECRET=zylo_super_secret_jwt_refresh_key_development_2026
COOKIE_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# --- Email & Nodemailer (SMTP Configuration) ---
# NOTE FOR COLLABORATORS & NEW CLONES:
# If left as placeholders, the server operates in DEVELOPMENT PREVIEW mode
# (logs clickable verification URLs directly to the terminal + Ethereal test inbox).
#
# Option A: Gmail SMTP (Recommended for Testing & Dev)
#   1. Enable 2-Step Verification on your Google Account:
#      https://myaccount.google.com/security
#   2. Generate a 16-character App Password:
#      https://myaccount.google.com/apppasswords (Select app: "Mail")
#   3. Fill in your Gmail and 16-character App Password below:
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=false
SMTP_FROM="Ramroxa" <noreply@ramroxa.com>

# Option B: Custom SMTP / Production (e.g. Amazon SES, SendGrid, Resend, Mailgun)
#   SMTP_SERVICE=
#   SMTP_HOST=smtp.mailprovider.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=smtp_username_or_api_key
#   SMTP_PASS=smtp_password_or_secret
#   SMTP_FROM="Ramroxa" <noreply@yourverifieddomain.com>

# --- Object Storage (S3 / Cloudflare R2) ---
S3_BUCKET=zylo-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY=mock_access_key
S3_SECRET_KEY=mock_secret_key

# --- Payment Gateways (Nepal Sandbox) ---
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET=8gBm/:&EnhH.1/q
FONEPAY_MERCHANT_CODE=FPAYTEST
FONEPAY_SECRET=fonepay_secret_test

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
