# ==============================================================================
# RAMROXA PRODUCTION VPS ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions on your Contabo VPS:
# 1. Copy this file: cp .env.production.example .env
# 2. Edit values: nano .env
# 3. Launch with Docker: docker compose up -d --build
# ==============================================================================

# --- Domain & Networking ---
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
COOKIE_DOMAIN=yourdomain.com

# --- Security & JWT (Generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace_with_a_secure_random_hex_string_32_characters_minimum
JWT_REFRESH_SECRET=replace_with_another_secure_random_hex_string_32_characters

# --- Initial Admin Setup ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword2026!
ADMIN_NAME=Super Admin
AUTO_SEED=true
FORCE_SEED=false

# --- Database ---
# If using the included local MongoDB container:
MONGODB_URI=mongodb://mongodb:27017/zylo_db
MONGO_INITDB_DATABASE=zylo_db
# (Optional) If using MongoDB Atlas cloud cluster instead, comment out the above and use:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/ramroxa?retryWrites=true&w=majority

# --- Live Email (SMTP) ---
# Required in production for user email verification and receipt delivery.
# Options: Resend, SendGrid, Amazon SES, or Gmail App Password:
SMTP_SERVICE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=false
SMTP_FROM="Ramroxa" <noreply@yourdomain.com>

# --- Object Storage (AWS S3 or Cloudflare R2 for Image Uploads) ---
S3_BUCKET=your-bucket-name
S3_REGION=ap-south-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# --- Nepal Payment Gateways ---
# Replace test credentials with live merchant credentials from eSewa / Fonepay
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET=8gBm/:&EnhH.1/q
FONEPAY_MERCHANT_CODE=FPAYTEST
FONEPAY_SECRET=fonepay_secret_test

# --- Ports ---
CLIENT_PORT=3000
API_PORT=5000
